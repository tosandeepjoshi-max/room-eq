<?xml version="1.0" encoding="utf-8"?>
<!-- Sleep Home: opens the launcher each time the Shield goes to sleep, so no app stays in front. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.joshi.sleephome"
    android:versionCode="1"
    android:versionName="1.0">

    <application android:label="Sleep Home" android:allowBackup="false">
        <service
            android:name=".SleepHomeService"
            android:label="Sleep Home"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/sleephome_service" />
        </service>
    </application>
</manifest>
