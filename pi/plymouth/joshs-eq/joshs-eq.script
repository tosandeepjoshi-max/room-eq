# Josh's EQ boot splash: splash.png fitted to the screen, aspect ratio kept, centred on black.
# splash.png is made at the touchscreen's native 800x480 by scripts/make_splash.py, so there it is 1:1.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

image = Image("splash.png");
scale = Math.Min(screen_width / image.GetWidth(), screen_height / image.GetHeight());
fitted = image.Scale(image.GetWidth() * scale, image.GetHeight() * scale);

if (Plymouth.GetMode() != "shutdown")
{
	sprite = Sprite(fitted);
	sprite.SetPosition((screen_width - fitted.GetWidth()) / 2, (screen_height - fitted.GetHeight()) / 2, -100);
}

# Boot messages (e.g. a file system check) along the bottom.
message_sprite = Sprite();
message_sprite.SetPosition(screen_width * 0.05, screen_height * 0.93, 10000);

fun message_callback(text)
{
	message_sprite.SetImage(Image.Text(text, 0.7, 0.7, 0.7));
}

Plymouth.SetUpdateStatusFunction(message_callback);
